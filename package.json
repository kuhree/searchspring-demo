{
  "name": "searchspring-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "lint": "eslint --ext .ts,tsx --ignore-path .gitignore .",
    "format": "prettier -u --write --ignore-path .gitignore \"**/*.{js,ts,tsx,css,html}\"",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "vite",
    "serve:preview": "vite preview",
    "serve:prod": "pnpm build && pnpm dlx serve dist"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-c8": "^0.33.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-react": "^7.37.5",
    "happy-dom": "^18.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sass": "^1.91.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "vitest-dom": "^0.1.1"
  }
}

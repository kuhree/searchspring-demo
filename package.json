{
  "name": "searchspring-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path .gitignore \"**/*.{js,ts,tsx,css,html}\"",
    "format:check": "prettier --check --ignore-path .gitignore \"**/*.{js,ts,tsx,css,html}\"",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "vite",
    "serve:preview": "vite preview",
    "serve:prod": "pnpm build && pnpm dlx serve dist"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vitest-dom": "^0.1.1"
  }
}
